{
  "name": "baton-run",
  "version": "0.1.0",
  "description": "Baton - conduct your dev sessions from any terminal. Flutter, Next.js, Vite, React Native: run, hot-reload, boot simulators, watch several projects at once, with a floating HUD and MCP access for coding agents.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "baton": "./src/cli/index.ts",
    "baton-daemon": "./src/daemon/main.ts",
    "baton-mcp": "./src/mcp/index.ts"
  },
  "scripts": {
    "test": "node --test --test-timeout=20000 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "daemon": "node src/daemon/main.ts",
    "hud": "node src/cli/index.ts hud",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jsonc-parser": "^3.3.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "flutter",
    "hot-reload",
    "launch.json",
    "mcp",
    "dev-server",
    "react-native",
    "nextjs",
    "vite",
    "cli",
    "agents",
    "claude-code",
    "simulator",
    "ios-simulator",
    "monorepo",
    "multi-project"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USERNAME/baton.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/baton/issues"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/baton#readme",
  "files": [
    "src",
    "hud",
    "assets",
    "README.md",
    "LICENSE"
  ]
}
