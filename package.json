{
  "name": "baton-run",
  "version": "0.2.6",
  "description": "Local run control plane for people and coding agents: launch, hot-reload, inspect, and capture evidence across Flutter and web apps.",
  "author": "kanumuri9593",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "baton": "bin/baton.js",
    "baton-daemon": "bin/baton-daemon.js",
    "baton-mcp": "bin/baton-mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-hud-assets.mjs",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepare": "node scripts/prepare.mjs",
    "release:check": "npm run build && npm run typecheck && npm test",
    "prepublishOnly": "npm run release:check",
    "test": "node --test --test-timeout=20000 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "daemon": "node src/daemon/main.ts",
    "app": "node src/cli/index.ts app",
    "hud": "node src/cli/index.ts hud",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.7.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "keywords": [
    "baton",
    "mcp",
    "model-context-protocol",
    "coding-agents",
    "ai-agents",
    "agent-tools",
    "developer-tools",
    "flutter",
    "hot-reload",
    "hud",
    "launch.json",
    "dev-server",
    "react-native",
    "nextjs",
    "vite",
    "cli",
    "simulator",
    "ios-simulator",
    "android-emulator",
    "monorepo",
    "multi-project",
    "devtools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanumuri9593/Baton.git"
  },
  "bugs": {
    "url": "https://github.com/kanumuri9593/Baton/issues"
  },
  "homepage": "https://kanumuri9593.github.io/Baton/",
  "files": [
    "bin",
    "dist",
    "hud",
    "assets",
    "scripts/copy-hud-assets.mjs",
    "scripts/prepare.mjs",
    "scripts/render-icons.mjs",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/launch-guide.md",
    "docs/app-settings.md",
    "docs/architecture.md",
    "examples/flutter-lab/.vscode/launch.json",
    "examples/flutter-lab/lib/main.dart",
    "examples/flutter-lab/pubspec.yaml",
    "examples/workflow-lab/api/*.mjs",
    "examples/workflow-lab/api/.vscode/launch.json",
    "examples/workflow-lab/console/server.mjs",
    "examples/workflow-lab/console/index.html",
    "examples/workflow-lab/console/.vscode/launch.json",
    "examples/workflow-lab/workflow.json",
    "examples/workflow-lab/README.md",
    "examples/workflow-lab/workflow-test.json",
    "examples/flutter-lab/README.md",
    "examples/flutter-lab/test/widget_test.dart"
  ]
}
